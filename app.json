{
  "expo": {
    "name": "SPARK WEAR",
    "slug": "sparkwear",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "sparkwear",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f1aba7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sparkwear.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "SPARKWEAR 需要存取您的照片庫，以便新增服裝照片。",
        "NSCameraUsageDescription": "SPARKWEAR 需要使用相機拍攝服裝照片。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sparkwear.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f1aba7"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SPARKWEAR 需要存取您的照片庫，以便新增服裝照片。",
          "cameraPermission": "SPARKWEAR 需要使用相機拍攝服裝照片。"
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-8914492142878610~7753825917"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97b73299-0361-4f6d-819f-3a7747b54802"
      }
    },
    "owner": "mimichild",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/97b73299-0361-4f6d-819f-3a7747b54802"
    }
  }
}
